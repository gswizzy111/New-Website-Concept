 "vars": {
  "--hover-lift-amount": "4px",
  "--hover-scale-amount": "1.03",
  "--hover-subtle-zoom-amount": "1.015",
  "--hover-shadow-color": "var(--color-shadow)",
  "--hover-transition-duration": ".25s",
  "--hover-transition-timing": "ease-out",
  "--surface-transition-duration": ".3s",
  "--surface-transition-timing": "var(--ease-out-quad)",
  "--mwb-display": "\"Archivo\", \"Poppins\", system-ui, sans-serif",
  "--mwb-body": "\"Poppins\", system-ui, sans-serif",
  "--mwb-crimson": "#a42325",
  "--mwb-green": "#82bd94",
  "--mwb-ink": "#243128",
  "--font-h1--family": "var(--mwb-display)",
  "--font-h2--family": "var(--mwb-display)",
  "--font-h3--family": "var(--mwb-display)",
  "--font-h4--family": "var(--mwb-display)",
  "--font-h5--family": "var(--mwb-display)",
  "--font-h6--family": "var(--mwb-display)",
  "--font-h1--weight": "800",
  "--font-h2--weight": "800",
  "--font-h3--weight": "700",
  "--font-h1--line-height": ".98",
  "--font-h2--line-height": "1",
  "--font-h1--letter-spacing": "-.02em",
  "--font-h2--letter-spacing": "-.015em",
  "--mwu-ink": "#181816",
  "--mwu-red": "#df3e35",
  "--mwu-red-deep": "#c5372d",
  "--mwu-white": "#ffffff",
  "--mwu-mint": "#3f7a52",
  "--mwu-radius": "14px",
  "--mwu-radius-card": "16px",
  "--mwu-display": "\"Inter Tight\", \"Arial Narrow\", Arial, sans-serif",
  "--mwu-ease": "cubic-bezier(.2, .8, .2, 1)",
  "--sidebar-width": "25rem",
  "--narrow-content-width": "36rem",
  "--normal-content-width": "42rem",
  "--wide-content-width": "46rem",
  "--narrow-page-width": "90rem",
  "--normal-page-width": "120rem",
  "--wide-page-width": "150rem",
  "--section-height-small": "15rem",
  "--section-height-medium": "25rem",
  "--section-height-large": "35rem",
  "--header-height": "0px",
  "--header-group-height": "var(--header-height)",
  "--transparent-header-offset-boolean": "0",
  "--text-align-default": "left"
 },
 "keyframes": [
  "mw-load-out: @keyframes mw-load-out { \n  100% { opacity: 0; visibility: hidden; }\n}",
  "mw-load-failsafe: @keyframes mw-load-failsafe { \n  100% { opacity: 0; visibility: hidden; pointer-events: none; }\n}",
  "mw-load-land: @keyframes mw-load-land { \n  0% { opacity: 0; transform: translateY(-18px) rotate(-16deg) scale(0.7); }\n  62% { opacity: 1; transform: translateY(0px) rotate(4deg) scale(1.06); }\n  100% { opacity: 1; ",
  "mw-load-word: @keyframes mw-load-word { \n  0% { opacity: 0; transform: translateY(7px); }\n  100% { opacity: 1; transform: none; }\n}",
  "fadeInUp: @keyframes fadeInUp { \n  0% { opacity: 0; transform: translateY(10px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}",
  "grow: @keyframes grow { \n  0% { transform: scale(1); }\n  50% { transform: scale(1.2); }\n  100% { transform: scale(1); }\n}",
  "slideInLeft: @keyframes slideInLeft { \n  0% { transform: translate(var(--custom-transform-from, 100%)); }\n  100% { transform: translate(var(--custom-transform-to, 0)); }\n}",
  "slideInLeftViewTransition: @keyframes slideInLeftViewTransition { \n  0% { transform: translate(100px); }\n}",
  "slideOutRight: @keyframes slideOutRight { \n  0% { transform: translate(0px); }\n  100% { transform: translate(var(--custom-transform-to, -100%)); }\n}",
  "slideInRight: @keyframes slideInRight { \n  0% { transform: translate(-100%); }\n  100% { transform: translate(0px); }\n}",
  "slideOutLeft: @keyframes slideOutLeft { \n  0% { transform: translate(0px); }\n  100% { transform: translate(100%); }\n}",
  "slideInTop: @keyframes slideInTop { \n  0% { transform: translateY(100%); }\n  100% { transform: translateY(0px); }\n}",
  "slideInTopViewTransition: @keyframes slideInTopViewTransition { \n  0% { transform: translateY(100px); }\n}",
  "slideOutBottom: @keyframes slideOutBottom { \n  0% { transform: translateY(0px); }\n  100% { transform: translateY(100%); }\n}",
  "slideInBottom: @keyframes slideInBottom { \n  0% { transform: translateY(-100%); }\n  100% { transform: translateY(0px); }\n}",
  "slideOutTop: @keyframes slideOutTop { \n  0% { transform: translateY(0px); }\n  100% { transform: translateY(-100%); }\n}",
  "cartBubbleSlideIn: @keyframes cartBubbleSlideIn { \n  0% { transform: translateY(-1em); }\n  100% { transform: translateY(0px); }\n}",
  "elementSlideInTop: @keyframes elementSlideInTop { \n  0% { margin-top: var(--padding-sm); opacity: 0; }\n  100% { margin-top: 0px; opacity: 1; }\n}",
  "elementSlideOutTop: @keyframes elementSlideOutTop { \n  0% { transform: translateY(0px); opacity: 1; }\n  100% { transform: translateY(var(--padding-sm)); opacity: 0; }\n}",
  "elementSlideInBottom: @keyframes elementSlideInBottom { \n  0% { transform: translateY(calc(-1 * var(--padding-sm))); opacity: 0; }\n  100% { transform: translateY(0px); opacity: 1; }\n}",
  "elementSlideOutBottom: @keyframes elementSlideOutBottom { \n  0% { transform: translateY(0px); opacity: 1; }\n  100% { transform: translateY(calc(-1 * var(--padding-sm))); opacity: 0; }\n}",
  "thumbnailsSlideInTop: @keyframes thumbnailsSlideInTop { \n  0% { transform: translateY(calc(-50% + var(--margin-lg))); opacity: 0; }\n  100% { transform: translateY(-50%); opacity: 1; }\n}",
  "thumbnailsSlideOutTop: @keyframes thumbnailsSlideOutTop { \n  0% { transform: translateY(-50%); opacity: 1; }\n  100% { transform: translateY(calc(-50% + var(--margin-lg))); opacity: 0; }\n}",
  "thumbnailsSlideInBottom: @keyframes thumbnailsSlideInBottom { \n  0% { transform: translateY(100%); opacity: 0; }\n  100% { transform: translateY(0px); opacity: 1; }\n}",
  "thumbnailsSlideOutBottom: @keyframes thumbnailsSlideOutBottom { \n  0% { transform: translateY(0px); opacity: 1; }\n  100% { transform: translateY(100%); opacity: 0; }\n}",
  "search-element-slide-in-bottom: @keyframes search-element-slide-in-bottom { \n  0% { transform: translateY(20px); opacity: 0; }\n  100% { transform: translateY(0px); opacity: 1; }\n}",
  "search-element-slide-out-bottom: @keyframes search-element-slide-out-bottom { \n  0% { transform: translateY(0px); opacity: 1; }\n  100% { transform: translateY(20px); opacity: 0; }\n}",
  "dialogZoom: @keyframes dialogZoom { \n  0% { opacity: 1; transform: scale(1) translateY(0px); }\n  100% { opacity: 0; transform: scale(0.95) translateY(1em); }\n}",
  "thumbnail-selected: @keyframes thumbnail-selected { \n  0%, 100% { box-shadow: transparent 0px 0px 0px 2px; scale: 0.9; }\n  50% { box-shadow: rgb(0, 0, 0) 0px 0px 0px 2px; scale: 1; }\n}",
  "backdropFilter: @keyframes backdropFilter { \n  0% { backdrop-filter: brightness(1); }\n  100% { backdrop-filter: brightness(0.75); }\n}"
 ],
 "fontFaces": [
  "Archivo 400 800 normal unloaded",
